{
	"name": "@repo/ui-overlays",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite build --watch",
		"build": "pnpm run check-types && vite build",
		"build-lib": "vite build",
		"check-types": "tsc --noEmit --incremental",
		"lint": "eslint --cache",
		"prettier": "prettier --write ./src",
		"validate": "echo 'Validation dependencies handled by Turbo'",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-dropdown-menu": "^2.1.15",
		"@radix-ui/react-hover-card": "^1.1.13",
		"@radix-ui/react-popover": "^1.1.14",
		"@repo/ui-core": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/tailwind-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@repo/ui-core": "workspace:*",
		"@repo/vite-config": "workspace:*",
		"@storybook/react-vite": "^10.2.16",
		"@types/react": "^19.1.11",
		"@types/react-dom": "^19.1.7",
		"eslint": "catalog:",
		"prettier": "^3.6.2",
		"storybook": "^10.2.16",
		"tailwindcss": "^4.1.12",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	}
}
