{
	"extends": "@repo/typescript-config/react.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"~/*": ["./src/*"],
			"react": ["./node_modules/@types/react"],
			"react-dom": ["./node_modules/@types/react-dom"]
		},
		"declaration": true,
		"outDir": "dist"
	},
	"include": ["src/**/*"],
	"exclude": ["dist", "node_modules"]
}
