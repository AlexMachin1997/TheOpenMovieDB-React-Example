{
	"name": "@repo/ui-forms",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite build --watch",
		"build": "pnpm run check-types && vite build",
		"build-lib": "vite build",
		"check-types": "tsc --noEmit --incremental",
		"lint": "eslint --cache",
		"prettier": "prettier --write ./src",
		"validate": "echo 'Validation dependencies handled by Turbo'",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-slider": "^1.3.6",
		"@repo/core": "workspace:*",
		"@repo/ui-command": "workspace:*",
		"@repo/ui-core": "workspace:*",
		"@repo/ui-overlays": "workspace:*",
		"@tanstack/react-form": "^1.23.8",
		"@tanstack/react-virtual": "^3.0.0-beta.54",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"lucide-react": "^0.541.0",
		"react-day-picker": "^9.9.0",
		"react-use": "^17.6.0",
		"tailwind-merge": "^3.3.1",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/tailwind-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@repo/ui-command": "workspace:*",
		"@repo/vite-config": "workspace:*",
		"@storybook/react-vite": "^10.2.16",
		"@storybook/test": "^8.6.15",
		"@tailwindcss/vite": "^4.1.12",
		"@types/react": "^19.1.11",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react-swc": "^4.0.1",
		"eslint": "^9.34.0",
		"prettier": "^3.6.2",
		"storybook": "^10.2.16",
		"tailwindcss": "^4.1.12",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-dts": "^4.3.0",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	}
}
