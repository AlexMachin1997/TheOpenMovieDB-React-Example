	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@repo/vite-config": "workspace:*",
		"@tailwindcss/vite": "^4.1.12",
		"@vitejs/plugin-react-swc": "^4.0.1",
		"@types/react": "^19.1.11",
		"@types/react-dom": "^19.1.7",
		"eslint": "^9.34.0",
		"prettier": "^3.6.2",
		"tailwindcss": "^4.1.12",
		"vite": "^7.1.3",
		"vite-plugin-dts": "^4.3.0",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
