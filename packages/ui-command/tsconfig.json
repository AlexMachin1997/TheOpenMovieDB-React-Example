{
	"extends": "@repo/typescript-config/react.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"~/*": ["./src/*"]
		},
		"declaration": true,
		"outDir": "dist",
		"rootDir": "./src",
		"types": ["@repo/typescript-config/types", "react", "react-dom", "vitest/globals"]
	},
	"include": ["src/**/*"],
	"exclude": ["dist", "node_modules"]
}
