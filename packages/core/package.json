{
	"name": "@repo/core",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./dates": {
			"types": "./dist/dates/index.d.ts",
			"import": "./dist/dates/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite build --watch",
		"build": "pnpm run check-types && vite build",
		"build-lib": "vite build",
		"check-types": "tsc --noEmit --incremental",
		"lint": "eslint --cache",
		"prettier": "prettier --write ./src",
		"validate": "echo 'Validation dependencies handled by Turbo'"
	},
	"dependencies": {
		"date-fns": "^4.1.0"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@repo/vite-config": "workspace:*",
		"eslint": "^9.34.0",
		"prettier": "^3.6.2",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-dts": "^4.3.0",
		"vitest": "^3.2.4",
		"tsx": "^4.0.1"
	}
}
