{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"types": ["@repo/typescript-config/types", "react", "react-dom", "vitest/globals"]
	},
	"include": [
		"src",
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/**/*.spec.ts",
		"src/**/*.spec.tsx",
		".storybook/*.ts",
		".storybook/**/*.ts"
	]
}
