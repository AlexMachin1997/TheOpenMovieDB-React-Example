{
	"$schema": "https://v2-8-8.turborepo.dev/schema.json",
	"ui": "tui",
	"globalDependencies": [".env*"],
	"globalEnv": ["NODE_ENV"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"prettier": {
			"dependsOn": ["^prettier"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {
			"dependsOn": ["^test"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"]
		},
		"validate": {
			"dependsOn": ["lint", "check-types"]
		}
	}
}
