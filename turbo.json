{
	"$schema": "https://v2-8-8.turborepo.dev/schema.json",
	"ui": "tui",
	"globalDependencies": [".env*"],
	"globalEnv": ["NODE_ENV"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"],
			"outputs": [".eslintcache"]
		},
		"prettier": {
			"dependsOn": ["^prettier"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": ["*.tsbuildinfo", "tsconfig.tsbuildinfo"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": []
		},
		"test:watch": {
			"cache": false,
			"persistent": true
		},
		"validate": {
			"dependsOn": ["lint", "check-types"]
		}
	}
}
